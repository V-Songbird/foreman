{
  "description": "Foreman for Codex. Review and trust these command hooks with /hooks. Task checkpoints use hooks/codex-task.js explicitly.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|clear)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"try{require(require('path').join(process.env.PLUGIN_ROOT,'hooks','session-start.js')).main()}catch{}\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"try{require(require('path').join(process.env.PLUGIN_ROOT,'hooks','guard-roadmap-edit.js')).main()}catch{}\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|PowerShell)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"try{require(require('path').join(process.env.PLUGIN_ROOT,'hooks','post-commit.js')).main()}catch{}\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(apply_patch|Read|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"try{require(require('path').join(process.env.PLUGIN_ROOT,'hooks','ledger-recall.js')).main()}catch{}\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"try{require(require('path').join(process.env.PLUGIN_ROOT,'hooks','stop.js')).main()}catch{}\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"try{require(require('path').join(process.env.PLUGIN_ROOT,'hooks','stop.js')).main()}catch{}\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
